# Threadline local development example. Copy to `.env` and adjust.
# NEVER commit real credentials. Values below are placeholders only.

THREADLINE_ENV=dev
DATABASE_URL=sqlite:///./data/threadline.db
MODEL_PROVIDER=openai-compatible
MODEL_NAME=placeholder-model
EMBEDDING_MODEL=placeholder-embeddings
GOOSE_ENABLED=false
VECTOR_ENABLED=false
VECTOR_BACKEND=memory
EMBEDDING_BACKEND=hash
MAX_INVESTIGATION_ITERATIONS=5
MAX_TOOL_CALLS=10
MAX_INVESTIGATION_SECONDS=300
MAX_RETRIEVAL_RESULTS=8
LOG_LEVEL=INFO
# Required when THREADLINE_ENV=prod; leave empty for local dev.
THREADLINE_API_TOKEN=
